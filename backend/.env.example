# LLM (OpenAI 兼容)
MODEL_API_URL=https://maas-api.cn-east-3.myhuaweicloud.com/v1/inferring/xxx/chat/completions
MODEL_API_KEY=replace-me
MODEL_NAME=DeepSeek-R1-671B
# PostgreSQL（唯一持久层；dev/test 缺省时走内存回退）
DATABASE_URL=postgresql://geekread:password@localhost:5432/geekread
# 预热调度（仅生产自动启用，60s 起步 AIMD 自适应）
WARM_CACHE_TOKEN=
WARM_TOP_N=50
WARM_LATEST_N=50
WARM_TREE_N=30
WARM_TREE_BUDGET=5
# 配额（topic 计费：一篇 story 完整翻译只扣 1 次配额）
# 评论翻译批次带 storyId 时按 topic 计数；旧客户端无 storyId 回退到按条计数（下方 legacy）。
FREE_DAILY_TOPICS=30
PRO_DAILY_TOPICS=200
# 每篇 topic 每天翻译请求批数上限（防超高楼帖子烧 LLM 成本）
TOPIC_REQUEST_CAP=40
# legacy 按条配额（无 storyId 的请求使用；未设 FREE_DAILY_TOPICS 时也回退引用）
FREE_DAILY_TRANSLATIONS=20
PRO_DAILY_TRANSLATIONS=500
# Pro 权益验签（与 MobileStarter server 共享密钥）
ENTITLEMENT_SIGNING_SECRET=replace-me
TRANSLATION_CACHE_VERSION=v1
# HN 数据源（Algolia 官方 API：search 一次返回完整 story，无需代理）
HACKER_NEWS_API_URL=https://hn.algolia.com/api/v1
# 出站代理（受限网络直连 HN/LLM 超时时启用；留空则 no-op）
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=localhost,127.0.0.1
